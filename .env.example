# Paul — the COP24 chat assistant. Set these in Vercel → Project cop24 → Settings → Environment Variables.
# With no key, Paul still works offline (app help, cited ERC clauses, feedback).

# Option A — OpenAI (used first when set). Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Option B — Anthropic Claude. Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: force one provider when both keys exist (openai | anthropic | offline)
PAUL_PROVIDER=

# Optional: send feedback to the team as GitHub issues
# Fine-grained token with Issues: read & write on the repository below
GITHUB_FEEDBACK_TOKEN=
GITHUB_FEEDBACK_REPO=classichot/cop24

# Sign-in and host desk (same model as ACC24). Without these the login is a demo gate.
# DEMO_SECRET signs sessions and demo links (any long random string); WORKSPACE_PASSWORD is the
# shared workspace password; HOST_PIN unlocks the host desk. DEMO_SECRET + HOST_PIN switch on the
# server-signed host desk; adding WORKSPACE_PASSWORD makes Paul and report drafting require sign-in.
DEMO_SECRET=
WORKSPACE_PASSWORD=
HOST_PIN=

# Optional: report-writing model (defaults to OPENAI_MODEL / ANTHROPIC_MODEL); must be benchmark-qualified
REPORT_MODEL=

# ── RAG24 shared evidence (optional; additive — COP24 works unchanged without it) ──
# A COP24 *service* credential issued by RAG24 (reader, explicit entity grants, ≤90 days). Server-side only.
# RAG24_URL=https://rag24.example.vercel.app
# RAG24_SERVICE_KEY=
# disabled (default) | search_pilot | workflows — must match the COP24 registration stage in RAG24
# RAG24_STAGE=disabled
# RAG24_PACK_VERSION=1.1.0
# Optional COP24 entity → RAG24 entity grant mapping
# RAG24_ENTITY_MAP={"lopburi-1":"lopburi-1"}
